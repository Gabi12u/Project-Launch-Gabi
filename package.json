{
  "name": "launch-gabi",
  "version": "1.0.3",
  "description": "Launch Gabi - a modern Minecraft launcher, mod manager and instance manager",
  "main": "./out/main/index.js",
  "author": "Gabi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "publish:win": "electron-vite build && electron-builder --win --publish always",
    "publish:mac": "electron-vite build && electron-builder --mac --publish always",
    "publish:linux": "electron-vite build && electron-builder --linux --publish always",
    "pack:win": "electron-vite build && electron-builder --win --publish never",
    "pack:mac": "electron-vite build && electron-builder --mac --publish never",
    "pack:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
